{
  "name": "omnifi",
  "version": "0.0.0",
  "private": true,
  "description": "Non-custodial multi-chain DEX with independently engineered EVM and Solana implementations",
  "license": "SEE LICENSE",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:evm": "cd chains/evm && forge test",
    "test:solana": "cd chains/solana && cargo test",
    "test:all": "pnpm test && pnpm test:evm && pnpm test:solana"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
